{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:markdown-preview": "node ./tools/build-markdown-preview.js",
    "prebuild": "npm run build:markdown-preview",
    "build": "hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "webp": "node ./tools/dispatch-webp.js",
    "gallery:compress": "node ./tools/optimize-gallery-images.js",
    "webp:win": "pwsh ./tools/convert-to-webp.ps1 && pwsh ./tools/update-markdown-images.ps1",
    "webp:mac": "bash ./tools/convert-to-webp.sh && bash ./tools/update-markdown-images.sh",
    "opt": "npm run webp && npm run clean && npm run build",
    "pub": "npm run opt && hexo deploy",
    "dev": "npm run webp && npm run clean && hexo server"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-markdown": "6.3.3",
    "@codemirror/language": "6.11.0",
    "@codemirror/search": "6.5.10",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.36.5",
    "@lezer/highlight": "1.2.1",
    "dompurify": "3.2.6",
    "esbuild": "0.25.2",
    "hexo": "^7.3.0",
    "hexo-asset-image": "github:CodeFalling/hexo-asset-image",
    "hexo-butterfly-envelope": "^1.0.15",
    "hexo-butterfly-extjs": "^1.4.18",
    "hexo-butterfly-swiper": "^1.0.12",
    "hexo-butterfly-tag-plugins-plus": "^1.0.18",
    "hexo-deployer-git": "^4.0.0",
    "hexo-filter-gitcalendar": "^1.0.11",
    "hexo-filter-mermaid-diagrams": "^1.0.5",
    "hexo-filter-optimize": "^0.3.1",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index-pin-top": "^0.2.2",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-kramed": "^0.1.4",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-wordcount": "^6.0.1",
    "image-size": "^2.0.2",
    "vanilla-lazyload": "^19.1.3"
  }
}
