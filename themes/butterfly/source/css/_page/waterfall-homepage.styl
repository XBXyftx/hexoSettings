/* 瀑布流首页样式 - 优化版 */
/* 2026-08-10：卡片换装 Windows XP 平面窗口风格（与首页轮播 swiper-xp.css 同一设计语言）。
   - 删除原封面信息区的激光/涟漪浮层（::before/::after 水纹、.waterfall-ripple 系列与六套玻璃配色）。
   - 悬浮动效重新设计为「窗口激活」语义：桌面 hover / 键盘 focus-within 点亮标题栏；
     触屏粗指针下窗口常激活，点按给出下沉反馈；reduced-motion 瞬时切换无过渡。
   - 同日按用户反馈改为深色版：标题栏蓝色保持不变，窗口内容区为深色阅读配色。
   - 瀑布流布局逻辑（列数/坐标）仍由 waterfall.js 负责，本文件只管视觉。 */

#recent-posts.waterfall-masonry
  // 轮播图样式重置
  .blog-slider
    width: 100% !important
    max-width: none !important
    margin-bottom: 20px !important

  // 瀑布流容器
  .waterfall-container
    position: relative !important
    width: 100% !important
    margin-bottom: 40px
    min-height: 400px
    overflow: visible !important
    box-sizing: border-box
    counter-reset: xp-window 0

    // 瀑布流项目基础样式（只重置定位，视觉全部在 .post-card-wrapper 上）
    .waterfall-item
      // 移除所有可能冲突的定位样式，让JS完全控制
      position: static // 初始状态为静态，JS会改为绝对定位
      display: block !important
      visibility: visible !important
      box-sizing: border-box !important
      margin: 0 !important
      padding: 0 !important
      border: none !important
      outline: none !important
      float: none !important
      clear: none !important
      background: transparent !important
      counter-increment: xp-window

      // ===== XP 窗口卡片（深色内容区） =====
      .post-card-wrapper
        position: relative
        display: flex
        flex-direction: column
        box-sizing: border-box
        height: auto
        padding-top: 30px // 顶部让位窗口标题栏
        background: #1e2431 // 深色内容区
        border: 3px solid #7f9db9 // 非激活：灰蓝窗口边框
        border-radius: 10px 10px 4px 4px
        box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.4) // 平面硬阴影
        overflow: hidden
        transition: border-color 0.2s ease, box-shadow 0.2s ease

        // 窗口标题栏（非激活灰蓝，含四色徽标与窗口名）
        &::before
          content: 'article_' counter(xp-window, decimal-leading-zero) '.exe'
          position: absolute
          top: 0
          left: 0
          right: 0
          height: 30px
          z-index: 5
          padding-left: 36px
          background-color: #46587a // XP 非激活标题栏（加深保证白字与绿徽标对比度）
          background-image: linear-gradient(#f65314, #f65314), linear-gradient(#7cbb00, #7cbb00), linear-gradient(#00a1f1, #00a1f1), linear-gradient(#ffbb00, #ffbb00)
          background-size: 7px 7px, 7px 7px, 7px 7px, 7px 7px
          background-position: 13px 8px, 21px 8px, 13px 16px, 21px 16px
          background-repeat: no-repeat
          color: #fff
          font-size: 12px
          font-weight: 700
          line-height: 30px
          letter-spacing: 1px
          text-align: left
          white-space: nowrap
          overflow: hidden
          pointer-events: none
          transition: background-color 0.2s ease

        // 标题栏装饰按钮组（最小化/最大化/关闭，多层 background 纯 CSS 绘制）
        &::after
          content: ''
          position: absolute
          top: 4px
          right: 6px
          width: 64px
          height: 22px
          z-index: 6
          pointer-events: none
          opacity: 0.55 // 非激活时淡化
          background-image: linear-gradient(45deg, transparent 44%, #fff 44%, #fff 56%, transparent 56%), linear-gradient(-45deg, transparent 44%, #fff 44%, #fff 56%, transparent 56%), linear-gradient(#fff, #fff), linear-gradient(#3a76f0, #3a76f0), linear-gradient(#fff, #fff), linear-gradient(#3a76f0, #3a76f0), linear-gradient(#3a76f0, #3a76f0), linear-gradient(#d75027, #d75027), linear-gradient(#16418f, #16418f), linear-gradient(#16418f, #16418f), linear-gradient(#8f2f12, #8f2f12)
          background-repeat: no-repeat
          background-size: 10px 10px, 10px 10px, 10px 10px, 6px 6px, 8px 3px, 18px 18px, 18px 18px, 18px 18px, 20px 20px, 20px 20px, 20px 20px
          background-position: 49px 6px, 49px 6px, 27px 6px, 29px 8px, 6px 13px, 1px 2px, 23px 2px, 45px 2px, 0 1px, 22px 1px, 44px 1px
          transition: opacity 0.2s ease

        // 键盘/触摸聚焦窗口同样激活（无障碍与触屏点选反馈）
        &:focus-within
          border-color: #0058e6
          box-shadow: 5px 5px 0 rgba(0, 0, 0, 0.45)

          &::before
            background-color: #0058e6

          &::after
            opacity: 1

        // 封面：深色衬底 + 灰蓝控件边框，直角图片
        .post_cover
          order: 0
          margin: 4px 4px 0
          padding: 4px
          background: #141922
          border: 1px solid #5d7a9e
          box-sizing: border-box
          overflow: hidden
          position: relative

          a
            display: block
            width: 100%

          img
            width: 100%
            height: auto
            display: block
            object-fit: contain
            border-radius: 0
            transition: filter 0.2s ease

        // 文章信息：深色窗口内容区
        .recent-post-info
          flex: 1
          display: flex
          flex-direction: column
          padding: 14px 16px 16px
          background: transparent

          .article-title
            margin-bottom: 10px

            a
              color: #9ecbff // 亮蓝白标题（深色阅读）
              font-size: 16px
              font-weight: 700
              line-height: 1.4
              text-decoration: none
              display: -webkit-box
              -webkit-line-clamp: 2
              -webkit-box-orient: vertical
              overflow: hidden
              transition: color 0.2s ease

              &:hover
                color: #cfe4ff
                text-decoration: underline

          .article-meta-wrap
            margin-bottom: 8px

          .article-meta
            display: flex
            flex-wrap: wrap
            align-items: center
            gap: 8px
            margin-bottom: 8px
            font-size: 12px
            color: #8a94a6

            i
              font-size: 11px
              color: #4d94ff

          // 标签：深色 XP 平面按钮（.tags 与 .article-meta 平级，不可嵌套进 .article-meta）
          .tags
            display: flex !important
            flex-wrap: wrap !important
            gap: 8px !important
            margin: 2px 0 8px !important

            .article-meta__tags
              display: inline-block !important
              background: #262e3d !important
              color: #c3cad7 !important
              padding: 3px 10px !important
              border: 1px solid #5d7a9e !important
              border-radius: 2px !important
              font-size: 12px !important
              text-decoration: none !important
              margin: 2px !important
              backdrop-filter: none !important
              -webkit-backdrop-filter: none !important
              transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease !important

              &:hover
                background: #0058e6 !important
                border-color: #0058e6 !important
                color: #fff !important

          .content
            color: #c3cad7
            font-size: 13px
            line-height: 1.6
            display: -webkit-box
            -webkit-line-clamp: 3
            -webkit-box-orient: vertical
            overflow: hidden
            margin-top: auto

// 响应式：宽度由 JS 控制，这里只微调信息区内边距与标题字号
@media (min-width: 1400px)
  #recent-posts.waterfall-masonry .waterfall-container .waterfall-item
    // JS会设置宽度，这里不需要CSS干预

@media (max-width: 768px)
  #recent-posts.waterfall-masonry .waterfall-container .waterfall-item
    // JS会设置宽度，这里不需要CSS干预

    .post-card-wrapper
      .recent-post-info
        padding: 12px 14px 14px

        .article-title a
          font-size: 15px

@media (max-width: 600px)
  #recent-posts.waterfall-masonry .waterfall-container .waterfall-item
    // JS会设置宽度，这里不需要CSS干预

    .post-card-wrapper
      .recent-post-info
        padding: 10px 12px 12px

        .article-title a
          font-size: 14px

// 桌面细指针：悬浮 = 窗口激活（标题栏点亮、边框变蓝、硬阴影加深、封面微提亮）
@media (hover: hover) and (pointer: fine)
  #recent-posts.waterfall-masonry .waterfall-container .waterfall-item .post-card-wrapper:hover
    border-color: #0058e6
    box-shadow: 5px 5px 0 rgba(0, 0, 0, 0.45)

    &::before
      background-color: #0058e6

    &::after
      opacity: 1

    .post_cover img
      filter: brightness(1.06)
      transform: none // 压掉 styles.css 遗留的封面 scale(1.05)

// 触屏/粗指针：窗口保持激活态（整屏灰窗不可取），点按给「按下」反馈
@media (hover: none), (pointer: coarse)
  #recent-posts.waterfall-masonry .waterfall-container .waterfall-item .post-card-wrapper
    border-color: #0058e6

    &::before
      background-color: #0058e6

    &::after
      opacity: 1

    &:active
      box-shadow: 1px 1px 0 rgba(0, 0, 0, 0.4)

      &::before
        background-color: #003da8

      .post_cover img
        filter: brightness(0.94)

    .post_cover:hover img
      transform: none // 触屏不放大封面

// 减少动态：颜色/阴影状态保留，过渡全部瞬时完成
@media (prefers-reduced-motion: reduce)
  #recent-posts.waterfall-masonry .waterfall-container .waterfall-item .post-card-wrapper
    transition: none

    &::before, &::after
      transition: none

    .post_cover img
      transition: none

    .recent-post-info
      .article-title a, .tags .article-meta__tags
        transition: none !important

// 确保侧边栏不受影响
.layout
  display: flex

  #recent-posts.waterfall-masonry
    flex: 1

  .aside-content
    flex-shrink: 0
    width: var(--aside-content-width, 300px)
    margin-left: 20px

    +maxWidth1024()
      display: none

// 分页组件样式
#recent-posts.waterfall-masonry
  #pagination
    display: block !important
    visibility: visible !important
    margin-top: 40px
    clear: both
    position: relative !important
    z-index: 10

    .pagination
      display: flex !important
      justify-content: center !important
      align-items: center !important
      gap: 10px

      .page-number, .extend
        display: inline-block !important
        visibility: visible !important
        opacity: 1 !important

      .current
        background: var(--theme-color) !important
        color: #fff !important

      .extend
        color: var(--font-color) !important

        &:hover
          color: var(--theme-color) !important

// 移除所有可能干扰JS布局的强制样式
#recent-posts.waterfall-masonry
  .waterfall-container
    .waterfall-item
      // 让JS完全控制定位，移除所有CSS定位干扰
      &.positioned
        // 只保留必要的显示样式，位置由JS控制
